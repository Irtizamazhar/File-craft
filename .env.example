# Canonical HTTPS origin used by metadata, robots and sitemap.
NEXT_PUBLIC_SITE_URL=https://www.editgoo.com
# Keep false while staging or before the site is complete and publicly accessible.
NEXT_PUBLIC_INDEXABLE=false
# Add real values from your own Google accounts. Leave blank initially.
NEXT_PUBLIC_ADSENSE_CLIENT=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# MySQL details created through Hostinger hPanel. Use 127.0.0.1 for Hostinger Node app.
DATABASE_URL=mysql://filecraft_user:CHANGE_ME@127.0.0.1:3306/filecraft
# Replace operator-specific information before publishing policy pages.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_NAME=

# Enable only after approval and certified CMP deployment/consent verification.
NEXT_PUBLIC_ADSENSE_APPROVED=false
NEXT_PUBLIC_CMP_READY=false

# Background removal server engine (services/background-removal, BiRefNet 1024). Leave empty to use only the
# in-browser model. Server-side only: never prefix with NEXT_PUBLIC_.
BG_REMOVAL_SERVICE_URL=
# Optional shared secret; must match SERVICE_TOKEN in the Python service.
BG_REMOVAL_SERVICE_TOKEN=
# Optional proxy timeout in milliseconds (default 180000; CPU-only servers need about 30-90 s per image).
BG_REMOVAL_TIMEOUT_MS=
