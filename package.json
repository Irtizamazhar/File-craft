{
  "name": "filecraft-hostinger-fullstack",
  "private": true,
  "version": "1.0.0",
  "description": "FileCraft: browser-first document tools, Next.js full-stack APIs and MySQL",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node scripts/copy-worker.mjs && next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "postinstall": "node scripts/copy-worker.mjs",
    "db:init": "node scripts/init-db.mjs",
    "check:source": "node scripts/check-source.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-hostinger.mjs"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.468.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "jszip": "3.10.1",
    "docx": "9.5.1",
    "mammoth": "1.9.0",
    "exceljs": "4.4.0",
    "pptxgenjs": "3.12.0",
    "mysql2": "3.12.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.8.3"
  }
}